COMPOSE_PROJECT_NAME=drawbase

APP_PORT=5173
API_PORT=3001

POSTGRES_PORT=54320
POSTGRES_DB=drawbase_dev
POSTGRES_USER=drawbase
# Required. Generate a unique local value before starting Docker Compose.
POSTGRES_PASSWORD=

MYSQL_PORT=33070
MYSQL_DATABASE=drawbase_dev
MYSQL_USER=drawbase
# Required. Generate unique local values before starting Docker Compose.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

CHOKIDAR_USEPOLLING=true
PROJECTS_DATA_DIR=/data/projects
# Leave empty to block network database introspection.
INTROSPECTION_ALLOWED_HOSTS=
# Keep disabled unless executing generated DDL in the local test databases.
SQL_EXECUTION_ENABLED=false
SQLITE_DATA_DIR=/data/sqlite
SQL_EXECUTION_LOG_DIR=/data/projects
