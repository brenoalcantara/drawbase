COMPOSE_PROJECT_NAME=drawbase

APP_PORT=5173
API_PORT=3001

POSTGRES_PORT=54320
POSTGRES_DB=change-me
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me

MYSQL_PORT=33070
MYSQL_DATABASE=change-me
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

CHOKIDAR_USEPOLLING=true
PROJECTS_DATA_DIR=/data/projects
INTROSPECTION_ALLOWED_HOSTS=localhost,127.0.0.1,postgres-test,mysql-test
POSTGRES_TEST_URL=postgresql://change-me:change-me@postgres-test:5432/change-me
MYSQL_TEST_URL=mysql://change-me:change-me@mysql-test:3306/change-me
SQLITE_DATA_DIR=/data/sqlite
SQL_EXECUTION_LOG_DIR=/data/projects
